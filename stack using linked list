//sum of recursion 
#include <iostream>
using namespace std;

int main()
{
    int a[100],n,pos,val,key;
    cout<<"enter the size:";
    cin>>n;
    cout<<"enter the element:";
   
    for(int i=0; i<n; i++)
    {
    cin>>a[i];
    }
    //inserting element
    cout<<"enter pos and value:";
    cin>>pos>>val;
    for(int i=0;i>=pos;i--)
    {
    a[i]=a[i+1];
    }
    a[pos-1]=val;
    n++;
    
   //delete
   cout<<"enter delete pos:";
   cin>>pos;
   for(int i=pos-1;i<n-1;i++)
   a[i]=a[i+1];
   n--;
   
   //seraching
   cout<<"enter pos and val:";
   cin>>key;
   for(int i=0;i<n;i++)
   if(a[i]==key)
   cout<<"found at position"<<i+1<<endl;
   
   //update
   cout<<"enter new position and value:";
   cin>>pos>>val;
   a[pos-1]=val;
   
   //display
   cout<<"final array";
   for(int i=0; i<n; i++)
   cout<<a[i]<<"";
   
   return 0;
}
